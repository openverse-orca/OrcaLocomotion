#usda 1.0
(
    defaultPrim = "MultiTerrainMap"
    doc = "Orca RL multi-terrain visual map inspired by mjlab rough terrain presets. 3x3 tiles: flat, random rough, slope, pyramid slope, stairs, waves, obstacles, stepping stones, beams."
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MultiTerrainMap"
{
    def Scope "Looks"
    {
        def Material "FlatGreen"
        {
            token outputs:surface.connect = </MultiTerrainMap/Looks/FlatGreen/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2200, 0.5000, 0.2800)
                color3f inputs:emissiveColor = (0.0176, 0.0400, 0.0224)
                float inputs:metallic = 0
                float inputs:opacity = 1.000
                float inputs:roughness = 0.7
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }
        def Material "RoughOlive"
        {
            token outputs:surface.connect = </MultiTerrainMap/Looks/RoughOlive/Shader.outputs:surface>
