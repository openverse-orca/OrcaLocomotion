            2, 6, 7, 3, 3, 7, 4, 0,
        ]
        float3[] extent = [(-14.5000, -14.5000, -0.0800), (14.5000, 14.5000, 0.0000)]
        rel material:binding = </MultiTerrainMap/Looks/BorderBlack> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token purpose = "default"
    }

